/* =========================================================
   SUARA (Text To Speech Bahasa Indonesia)
   ========================================================= */
function ucap(teks, rate){
  rate = rate || 0.92;
  if(!('speechSynthesis' in window)) return;
  try{
    window.speechSynthesis.cancel();
    var u = new SpeechSynthesisUtterance(teks);
    u.lang = 'id-ID';
    u.rate = rate;
    u.pitch = 1.15;
    u.volume = 1;
    var v = window.speechSynthesis.getVoices().find(function(v){return /id|Indo/i.test(v.lang);});
    if(v) u.voice = v;
    window.speechSynthesis.speak(u);
  }catch(e){}
}
function stopSuara(){ if('speechSynthesis' in window) window.speechSynthesis.cancel(); }

