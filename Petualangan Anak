var ART = {rumah:artRumah, bagi:artBagi, giliran:artGiliran, maaf:artMaaf,
           tolong:artTolong, kerjasama:artKerjasama, sedih:artSedih,
           hibur:artHibur, kelas:artKelas, cover:artCover, end:artEnd};

/* =========================================================
   STATE GAME
   ========================================================= */
var idx = 0;
var skor = 0;
var subStep = null;
var terkunci = false;

function showPage(id){
  var pages = document.querySelectorAll('.page');
  for(var i=0;i<pages.length;i++) pages[i].classList.remove('active');
  document.getElementById(id).classList.add('active');
}

function startGame(){
  idx = 0; skor = 0; subStep = null;
  updateSkor();
  showPage('page-quiz');
  renderSoal();
  ucap('Ayo mulai petualangan! Bantu Lala memilih tindakan yang baik.');
}
function renderSoal(){
  var s = SOAL[idx];
  var data = subStep ? subStep : s;

  document.getElementById('pill-step').textContent = s.label;
  document.getElementById('q-situ').textContent = data.situasi;
  document.getElementById('q-ask').textContent = data.tanya;
  document.getElementById('q-art').innerHTML = ART[data.art] ? ART[data.art]() : '';

  var total = SOAL.length;
  var progresSekarang = subStep ? idx + 0.5 : idx;
  document.getElementById('prog').style.width = ((progresSekarang/total)*100).toFixed(1) + '%';

  var wrap = document.getElementById('q-options');
  wrap.innerHTML = '';
  terkunci = false;

  var huruf = ['A','B','C'];
  data.opsi.forEach(function(o,i){
    var b = document.createElement('button');
    b.className = 'opt';
    b.innerHTML = '<span class="letter">'+huruf[i]+'</span><span>'+o.teks+'</span>';
    b.dataset.index = i;
    b.onclick = function(){ pilihJawaban(b, o, data); };
    wrap.appendChild(b);
  });
  var fb = document.getElementById('q-feedback');
  fb.className = 'feedback';
  fb.querySelector('#fb-text').textContent = '';
  document.getElementById('next-btn').classList.remove('show');
  document.getElementById('next-btn').textContent = 'LANJUT ➜';

  setTimeout(function(){ ucap(data.suaraSituasi); }, 320);
}

function pilihJawaban(btn, opsi, data){
  if(terkunci) return;
  terkunci = true;

  var semua = document.querySelectorAll('#q-options .opt');
  for(var i=0;i<semua.length;i++) semua[i].disabled = true;

  var fb = document.getElementById('q-feedback');
  var fbText = document.getElementById('fb-text');
  var fbEmo = document.getElementById('fb-emo');

  if(opsi.benar){
    btn.classList.add('correct');
    for(var i=0;i<semua.length;i++){ if(semua[i]!==btn) semua[i].classList.add('dim'); }

    skor += SKOR_PER_BENAR;
    updateSkor();
fb.className = 'feedback ok show';
    fbEmo.textContent = opsi.emo || '🎉';
    fbText.textContent = opsi.fb || 'Hebat! Jawabanmu tepat!';
    ucap(opsi.fbSuara || opsi.fb || 'Hebat! Jawabanmu tepat!');

    confetti();
    popBintang();

    var nextBtn = document.getElementById('next-btn');

    if(opsi.lanjut){
      nextBtn.classList.add('show');
      nextBtn.textContent = 'LANJUT ➜';
      nextBtn.onclick = function(){
        subStep = opsi.lanjut;
        renderSoal();
        setTimeout(function(){ ucap(opsi.lanjut.suaraSituasi); }, 320);
      };
    } else if(subStep){
      nextBtn.classList.add('show');
      nextBtn.textContent = 'LANJUT ➜';
      nextBtn.onclick = function(){ subStep = null; idx++; nextStep(); };
    } else {
      nextBtn.classList.add('show');
      nextBtn.textContent = 'LANJUT ➜';
      nextBtn.onclick = function(){ idx++; nextStep(); };
    }
  } else {
    btn.classList.add('wrong');
fb.className = 'feedback no show';
    fbEmo.textContent = '🤔';
    fbText.textContent = 'Belum tepat. Coba pilih jawaban yang lain ya!';
    ucap('Belum tepat. Coba pilih jawaban yang lain ya!');

    setTimeout(function(){
      btn.disabled = true;
      btn.classList.add('dim');
      var sisa = [];
      var all = document.querySelectorAll('#q-options .opt');
      for(var i=0;i<all.length;i++){
        if(!all[i].classList.contains('dim') && all[i]!==btn) sisa.push(all[i]);
      }
      for(var j=0;j<sisa.length;j++) sisa[j].disabled = false;
      terkunci = false;
      fb.className = 'feedback';
    }, 1200);
  }
}

function nextStep(){
  if(idx >= SOAL.length){
    tampilkanSelesai();
  } else {
    renderSoal();
  }
}

function updateSkor(){
  document.getElementById('pill-score').textContent = '⭐ ' + skor + ' poin';
}
function confetti(){
  var fx = document.getElementById('fx');
  var emojis = ['⭐','🌟','✨','🎉','💖','🎈','🍭','🌈'];
  for(var i=0;i<26;i++){
    var el = document.createElement('div');
    el.className = 'conf';
    el.textContent = emojis[Math.floor(Math.random()*emojis.length)];
    el.style.left = Math.random()*100 + 'vw';
    el.style.fontSize = (18 + Math.random()*22) + 'px';
    el.style.animationDuration = (1.6 + Math.random()*1.6) + 's';
    el.style.animationDelay = (Math.random()*0.35) + 's';
    fx.appendChild(el);
    (function(e){ setTimeout(function(){ e.remove(); }, 3600); })(el);
  }
}

function popBintang(){
  var el = document.createElement('div');
  el.className = 'pop-star';
  el.textContent = '🌟';
  document.body.appendChild(el);
  setTimeout(function(){ el.remove(); }, 1100);
}

function tampilkanSelesai(){
  showPage('page-end');
  document.getElementById('end-score').textContent = skor;
  document.getElementById('end-max').textContent = SOAL.length * SKOR_PER_BENAR;
  document.getElementById('end-lala').innerHTML = ART.end();
  var maks = SOAL.length * SKOR_PER_BENAR;
  var rasio = skor / maks;
  var bintang = 1;
  if(rasio >= 0.85) bintang = 3;
  else if(rasio >= 0.6) bintang = 2;
  var bStr = '';
  for(var i=0;i<bintang;i++) bStr += '⭐';
  for(var j=0;j<3-bintang;j++) bStr += '☆';
  document.getElementById('end-stars').textContent = bStr;

  setTimeout(function(){
    ucap('Selamat! Kamu sudah membantu Lala melewati berbagai kegiatan sehari-hari. Menjadi anak yang baik berarti belajar peduli, berbagi, bekerja sama, dan menghargai orang lain.');
  }, 400);

  for(var k=0;k<3;k++){
    setTimeout(confetti, k*400);
  }
}

function restartGame(){
  stopSuara();
  idx = 0; skor = 0; subStep = null; terkunci = false;
  updateSkor();
  showPage('page-1');
  document.getElementById('prog').style.width = '0%';
  setTimeout(function(){ ucap('Hai! Aku Lala. Ayo ikut aku berpetualang hari ini!'); }, 300);
}

function speakStory(){
  var s = SOAL[idx];
  var data = subStep ? subStep : s;
  ucap(data.suaraSituasi + ' ' + data.tanya);
}

document.getElementById('art-cover').innerHTML = ART.cover();
updateSkor();
</script>
