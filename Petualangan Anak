<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Petualangan Sehari-hari - Game Edukasi Anak</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  :root{
    --pink:#FFB6C1; --pink-soft:#FFD9E0; --blue:#A8D8EA; --blue-deep:#7EC4E8;
    --yellow:#FFE59D; --yellow-deep:#FFD24C; --green:#B8E6B8; --green-deep:#7FD67F;
    --purple:#D9C2F0; --orange:#FFC49B; --cream:#FFF9F0; --text:#5A4A42;
  }
  body{
    font-family:'Comic Sans MS','Segoe UI',Verdana,sans-serif;
    background:linear-gradient(160deg,#BFE9FF 0%,#FFE9F3 45%,#FFF7D6 100%);
    min-height:100vh; display:flex; align-items:center; justify-content:center;
    padding:16px; color:var(--text); overflow-x:hidden;
  }
  #app{
    width:100%; max-width:920px; background:var(--cream);
    border-radius:36px; box-shadow:0 14px 40px rgba(120,100,140,.28);
    padding:26px 30px 32px; position:relative; overflow:hidden;
    border:6px solid #fff;
  }
  .deco{position:absolute;opacity:.55;pointer-events:none;font-size:26px}
  .d1{top:14px;left:18px}.d2{top:22px;right:26px}.d3{bottom:16px;left:30px}
  .d4{bottom:22px;right:20px}.d5{top:50%;left:6px}.d6{top:48%;right:8px}
  @keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
  .floaty{animation:floaty 3.2s ease-in-out infinite}
  .page{display:none; animation:pop .45s cubic-bezier(.34,1.56,.64,1)}
  .page.active{display:block}
  @keyframes pop{from{opacity:0;transform:scale(.94) translateY(14px)}to{opacity:1;transform:none}}
  .btn{
    border:none; cursor:pointer; font-family:inherit; font-weight:bold;
    border-radius:999px; transition:transform .15s, box-shadow .15s, filter .15s;
    display:inline-flex; align-items:center; justify-content:center; gap:10px;
    text-align:center; line-height:1.25;
  }
  .btn:active{transform:scale(.95)}
  .btn-big{
    font-size:26px; padding:20px 54px; color:#fff;
    background:linear-gradient(180deg,#FFB347,#FF8C42);
    box-shadow:0 8px 0 #D96E22, 0 12px 22px rgba(217,110,34,.35);
  }
  .btn-big:hover{filter:brightness(1.06)}
  .btn-big:active{box-shadow:0 4px 0 #D96E22; transform:translateY(4px) scale(.98)}
  .hero{text-align:center; padding:6px 0 4px}
  .hero h1{
    font-size:clamp(30px,6vw,54px); color:#FF6FA5; letter-spacing:1px;
    text-shadow:3px 3px 0 #fff, 6px 6px 0 #FFD9E0; margin-bottom:6px;
  }
  .hero .sub{
    font-size:clamp(16px,2.6vw,24px); color:#7A6A62; background:#FFF1C9;
    display:inline-block; padding:10px 26px; border-radius:999px; margin-bottom:10px;
    border:3px dashed #FFD24C;
  }
  .lala-wrap{display:flex; justify-content:center; margin:6px 0 4px}
  .lala-wrap svg{width:min(300px,62vw); height:auto; filter:drop-shadow(0 10px 14px rgba(0,0,0,.12))}
  .bubble{
    background:#fff; border:4px solid var(--blue); border-radius:24px;
    padding:12px 20px; font-size:clamp(15px,2.2vw,20px); color:#4A6E82;
    display:inline-block; max-width:560px; position:relative; margin-bottom:16px;
  }
  .bubble::after{
    content:''; position:absolute; bottom:-16px; left:50%; transform:translateX(-50%);
    border:8px solid transparent; border-top-color:var(--blue);
  }
  .topbar{display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:10px}
  .pill{
    background:#fff; border:3px solid var(--purple); border-radius:999px;
    padding:7px 18px; font-size:16px; font-weight:bold; color:#7C5CA8; white-space:nowrap;
  }
  .pill.score{border-color:var(--yellow-deep); color:#B8791A; background:#FFFBEC}
  .prog-wrap{flex:1; height:18px; background:#EFE6DA; border-radius:999px; overflow:hidden; border:3px solid #fff}
  .prog{height:100%; width:0%; background:linear-gradient(90deg,#7FD67F,#B8E6B8); border-radius:999px; transition:width .5s}
  .scene{
    display:flex; align-items:center; gap:18px; background:#fff;
    border-radius:28px; padding:16px 20px; border:4px solid var(--blue);
    box-shadow:0 6px 0 #DCEEF7; margin-bottom:14px; flex-wrap:wrap;
  }
  .scene .art{flex:0 0 auto; display:flex; justify-content:center}
  .scene .art svg{width:min(320px,72vw); height:auto}
  .scene .story{flex:1 1 260px; min-width:240px}
  .scene .story .situ{font-size:clamp(16px,2.3vw,21px); line-height:1.5; color:#4E5A63;}
  .listen{
    margin-top:10px; background:#EAF7FF; border:3px solid var(--blue-deep); color:#2E7BA6;
    font-size:15px; padding:8px 18px; border-radius:999px; cursor:pointer; font-family:inherit; font-weight:bold;
  }
  .listen:hover{background:#D8F0FF}
  .ask{
    font-size:clamp(18px,2.8vw,25px); font-weight:bold; color:#E1568C;
    text-align:center; margin:6px 0 14px;
  }
  .options{display:flex; flex-direction:column; gap:12px; margin-bottom:14px}
  .opt{
    display:flex; align-items:center; gap:14px; width:100%; text-align:left;
    background:#fff; border:4px solid #E7DFD5; border-radius:22px; padding:14px 18px;
    font-size:clamp(16px,2.3vw,21px); color:#4E5A63; cursor:pointer; font-family:inherit;
    transition:transform .15s, border-color .2s, background .2s, box-shadow .2s;
    box-shadow:0 5px 0 #EDE5DA;
  }
  .opt:hover:not(:disabled){transform:translateY(-2px); border-color:var(--blue-deep); background:#F5FCFF}
  .opt:disabled{cursor:default}
  .opt .letter{
    flex:0 0 auto; width:44px; height:44px; border-radius:50%;
    background:var(--yellow); color:#9A6A0E; font-weight:bold; font-size:22px;
    display:flex; align-items:center; justify-content:center; border:3px solid #fff;
    box-shadow:0 2px 6px rgba(0,0,0,.1);
  }
  .opt.correct{border-color:#5FBF5F; background:#EAFBEA; box-shadow:0 5px 0 #BFE9BF; animation:shake-yes .5s}
  .opt.correct .letter{background:#B8E6B8; color:#2F7A2F}
  .opt.wrong{border-color:#FFA8A8; background:#FFF1F1; box-shadow:0 5px 0 #FFD6D6; animation:shake-no .45s}
  .opt.wrong .letter{background:#FFC9C9; color:#B23B3B}
  .opt.dim{opacity:.5}
  @keyframes shake-yes{0%,100%{transform:scale(1)}40%{transform:scale(1.04)}}
  @keyframes shake-no{0%,100%{transform:translateX(0)}25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
  .feedback{
    border-radius:24px; padding:16px 20px; font-size:clamp(16px,2.3vw,21px);
    display:none; align-items:center; gap:14px; line-height:1.45;
    animation:pop .4s cubic-bezier(.34,1.56,.64,1);
  }
  .feedback.show{display:flex}
  .feedback.ok{background:#EAFBEA; border:4px solid #7FD67F; color:#2F7A2F}
  .feedback.no{background:#FFF6E5; border:4px solid #FFD24C; color:#9A6A0E}
  .feedback .emo{font-size:42px; flex:0 0 auto}
  .feedback .fb-text{flex:1}
  .next-btn{
    margin-top:12px; font-size:20px; padding:14px 34px; color:#fff;
    background:linear-gradient(180deg,#7EC4E8,#4FA8D8);
    box-shadow:0 7px 0 #3487B3, 0 10px 18px rgba(52,135,179,.3);
    display:none;
  }
  .next-btn.show{display:inline-flex; animation:pop .4s}
  .next-btn:active{box-shadow:0 3px 0 #3487B3; transform:translateY(4px)}
  .next-row{text-align:center}
  .finish{text-align:center; padding:8px 0}
  .finish h2{
