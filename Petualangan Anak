  .finish .msg{font-size:clamp(16px,2.4vw,21px); color:#5A4A42; max-width:620px; margin:0 auto 12px; line-height:1.6}
  .stars{font-size:clamp(34px,7vw,52px); letter-spacing:6px; margin:6px 0 4px}
  .score-box{
    display:inline-block; background:#fff; border:5px solid var(--yellow-deep);
    border-radius:30px; padding:16px 42px; margin:10px 0 16px;
    box-shadow:0 8px 0 #FFE08A;
  }
  .score-box .lab{font-size:17px; color:#B8791A}
  .score-box .val{font-size:clamp(38px,8vw,58px); font-weight:bold; color:#FF8C42; line-height:1.1}
  .score-box .max{font-size:17px; color:#B8791A}
  .pesan{
    background:#FFF1C9; border:4px dashed #FFD24C; border-radius:26px;
    padding:16px 24px; max-width:640px; margin:0 auto 18px; font-size:clamp(15px,2.2vw,19px);
    line-height:1.6; color:#8A6A28;
  }
  #fx{position:fixed; inset:0; pointer-events:none; overflow:hidden; z-index:99}
  .conf{position:absolute; font-size:26px; animation:fall linear forwards}
  @keyframes fall{
    0%{transform:translateY(-40px) rotate(0deg); opacity:1}
    100%{transform:translateY(105vh) rotate(540deg); opacity:0}
  }
  .pop-star{
    position:fixed; font-size:70px; z-index:100; pointer-events:none;
    animation:starPop 1s ease-out forwards; left:50%; top:38%; transform:translate(-50%,-50%);
  }
  @keyframes starPop{
    0%{transform:translate(-50%,-50%) scale(0) rotate(-40deg); opacity:0}
    35%{transform:translate(-50%,-50%) scale(1.25) rotate(8deg); opacity:1}
    100%{transform:translate(-50%,-50%) scale(1.9) rotate(20deg); opacity:0}
  }
  @media(max-width:560px){
    #app{padding:18px 16px 24px; border-radius:26px}
    .btn-big{font-size:21px; padding:16px 34px}
    .opt{padding:12px 14px; gap:10px}
    .opt .letter{width:38px;height:38px;font-size:19px}
  }
</style>
</head>
