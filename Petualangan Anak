/* =========================================================
   ILUSTRASI SVG
   ========================================================= */
var SKIN='#F7D0AE', SKIN2='#E8B98C', HAIR='#4A3A32', HAIR2='#6B4F3F';

function anak(x,y,s,opt){
  opt = opt || {};
  var baju = opt.baju || '#FFB6C1';
  var rambut = opt.rambut || HAIR;
  var hairstyle = opt.hairstyle || 'ponytail';
  var ekspresi = opt.ekspresi || 'senang';
  var kulit = opt.kulit || SKIN;
  var lengan = opt.lengan || 'turun';
  var rok = opt.rok || '#FF8FB1';

  var g = [];
  var bodyW = 46*s, bodyH = 52*s;
  var headR = 27*s;
  var headCY = y - bodyH - headR - 6*s;

  var mata, mulut, pipi='';
  if(ekspresi==='senang'){
    mata = '<ellipse cx="'+(-9*s)+'" cy="'+(headCY-2*s)+'" rx="'+(3.6*s)+'" ry="'+(4.6*s)+'" fill="#3A2E28"/>'+
           '<ellipse cx="'+(9*s)+'" cy="'+(headCY-2*s)+'" rx="'+(3.6*s)+'" ry="'+(4.6*s)+'" fill="#3A2E28"/>'+
           '<circle cx="'+(-8*s)+'" cy="'+(headCY-3.4*s)+'" r="'+(1.3*s)+'" fill="#fff"/>'+
           '<circle cx="'+(10*s)+'" cy="'+(headCY-3.4*s)+'" r="'+(1.3*s)+'" fill="#fff"/>';
    mulut = '<path d="M '+(-8*s)+' '+(headCY+10*s)+' Q 0 '+(headCY+18*s)+' '+(8*s)+' '+(headCY+10*s)+'" stroke="#B5563F" stroke-width="'+(2.6*s)+'" fill="none" stroke-linecap="round"/>';
    pipi = '<circle cx="'+(-16*s)+'" cy="'+(headCY+6*s)+'" r="'+(4.2*s)+'" fill="#FFB3C6" opacity=".7"/>'+
           '<circle cx="'+(16*s)+'" cy="'+(headCY+6*s)+'" r="'+(4.2*s)+'" fill="#FFB3C6" opacity=".7"/>';
